# Settings for AWS work: `uv run ...` on the host, and scripts/deploy.sh.
# `docker compose up` does NOT read these. The local stack's settings are in docker-compose.yml.
# Every value is optional: anything left unset falls back to an in-memory implementation.

AWS_REGION=ap-south-1
AGENT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
JUDGE_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Filled from `terraform output` (scripts/env_from_terraform.sh writes these for you)
ORDERS_TABLE=
HISTORY_TABLE=
CHECKPOINT_TABLE=
KNOWLEDGE_BASE_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=

# local | mcp  - how the agent reaches its read-only tools
TOOLS_TRANSPORT=local

# Change the local models without editing docker-compose.yml (the only two values compose reads)
# LOCAL_CHAT_MODEL=qwen/qwen3-30b-a3b-2507
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# LangSmith tracing (https://smith.langchain.com -> Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=shophelper
LANGSMITH_API_KEY=
